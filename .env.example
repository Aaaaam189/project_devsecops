

# Docker Compose PostgreSQL credentials
DB_USERNAME=postgres
DB_PASSWORD=change-me-db-password

# Kubernetes PostgreSQL bootstrap credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin-password
POSTGRES_APP_USER=foundersync_app
POSTGRES_APP_PASSWORD=change-me-postgres-app-password

# RabbitMQ administrator credentials
RABBITMQ_ADMIN_USER=rabbitmq_admin
RABBITMQ_ADMIN_PASSWORD=change-me-rabbitmq-admin-password

# RabbitMQ application credentials
RABBITMQ_APP_USER=foundersync_app
RABBITMQ_APP_PASSWORD=change-me-rabbitmq-app-password

# MongoDB credentials
MONGO_ADMIN_USER=mongodb_admin
MONGO_ADMIN_PASSWORD=change-me-mongodb-password
MONGO_CHAT_USER=foundersync_chat
MONGO_CHAT_PASSWORD=change-me-mongodb-chat-password

# Shared JWT signing secret; use a long random value
JWT_SECRET=change-me-with-a-long-random-jwt-secret
